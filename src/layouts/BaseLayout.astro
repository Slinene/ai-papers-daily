---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'AI Papers Daily', description = 'Daily AI / RecSys papers, summarized by an agent.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={`${base}/rss.xml`} />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <h1 class="site-title"><a href={`${base}/`}>AI Papers Daily</a></h1>
        <p class="site-tagline">每天自动收集、过滤、总结推荐系统与大模型方向的论文。</p>
        <nav class="nav">
          <a href={`${base}/`}>首页</a>
          <a href={`${base}/archive`}>归档</a>
          <a href={`${base}/categories`}>分类</a>
          <a href={`${base}/tags`}>标签</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      Built by an agent · Powered by Astro · <a href="https://github.com">Source on GitHub</a>
    </footer>
  </body>
</html>
