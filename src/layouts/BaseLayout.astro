---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'AI Papers Daily', description = '每日 AI / 电商 / 推荐系统 / Agent 论文与行业动态精选。' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url?.pathname?.replace(/\/$/, '') || '';
const isActive = (p: string) => pathname === `${base}${p}`.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={`${base}/rss.xml`} />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <div class="brand">
          <a href={`${base}/`} aria-label="home">
            <span class="logo">AI</span>
          </a>
          <div>
            <h1 class="site-title"><a href={`${base}/`}>AI Papers Daily</a></h1>
            <p class="site-tagline">每日 AI / 电商 / 推荐系统 / Agent 论文精选</p>
          </div>
        </div>
        <nav class="nav">
          <a href={`${base}/`} class={isActive('') ? 'active' : ''}>首页</a>
          <a href={`${base}/collection`} class={pathname.startsWith(`${base}/collection`) ? 'active' : ''}>论文沉淀</a>
          <a href={`${base}/archive`} class={isActive('/archive') ? 'active' : ''}>归档</a>
          <a href={`${base}/categories`} class={isActive('/categories') ? 'active' : ''}>分类</a>
          <a href={`${base}/tags`} class={isActive('/tags') ? 'active' : ''}>标签</a>
        </nav>
      </div>
    </header>
    <div class="layout">
      <Sidebar />
      <main class="content">
        <slot />
      </main>
    </div>
    <footer>
      <slot name="footer" />
      <div>
        Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> & DeepSeek
      </div>
    </footer>
  </body>
</html>
